@model IEnumerable<WebApplication1.Petshop.DAL.Models.Product>
@{
    ViewData["Petshop"] = "Home Page";



}

<head>
    <title>Petshop</title>
    <link rel=" stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />



</head>    
<body>
    <div class="text-center ">

        <h1 class="display-4">Dobrodosli u najbolji petshop u srbiji</h1>
        <table class="table table-hover align-middle">

            <thead class="table-primary">
                <tr>
                    <th></th>
                    <th>Naziv</th>
                    <th>Cena</th>
                    <th>Količina na stanju</th>
                    <th>Opis</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>


                        <td>
                            @{
                             string imgname = "~/images/larry the fish.png"; 
                              
                             if(!String.IsNullOrWhiteSpace(item.naziv)){
                             imgname = item.naziv.ToLower().Trim().Replace(" ","-") + ".png"; }
                                
                               
                             } 
                            <img src="@Url.Content("~/images/" + imgname)" alt="@item.naziv" width="270" />

                        </td>

                        <td class="fw-semibold">
                            @item.naziv
                        </td>

                        <td class="text-primary fw-bold">
                            @item.cena.ToString("N2") RSD
                        </td>

                        <td>
                            @item.kolicinanastanju
                        </td>

                        <td>
                            @item.opis
                        </td>
                    </tr>
                }
            </tbody>

